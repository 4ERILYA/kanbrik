# Адрес сайта без слеша в конце
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Длинная случайная строка: openssl rand -hex 32
PAYLOAD_SECRET=

# База данных (файл SQLite)
DATABASE_URI=file:./kanbrik.db

# Почта для писем о заказах (например, Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ЮKassa: личный кабинет → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 = передавать чек в ЮKassa (54-ФЗ). Включайте, когда подключите онлайн-кассу ЮKassa.
YOOKASSA_SEND_RECEIPT=0
# Ставка НДС в чеке: 1 = без НДС
YOOKASSA_VAT_CODE=1

# Telegram-уведомления о заказах (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
