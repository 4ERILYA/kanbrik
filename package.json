    "graphql": "16.11.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
